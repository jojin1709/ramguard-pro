{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RAMGuard Pro",
  "version": "0.1.0",
  "identifier": "com.jojinjohn.ramguardpro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RAMGuard Pro",
        "width": 980,
        "height": 680,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "JOJIN JOHN",
    "copyright": "Copyright (c) 2026 JOJIN JOHN. All Rights Reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "icons/installer_sidebar.bmp",
        "installMode": "both",
        "displayLanguageSelector": false
      }
    }
  }
}
